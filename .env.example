# Watchtower environment (copy to .env)
DATABASE_URL="file:./dev.db"

# Phase 0 admin secret — set a long random string before deploying
# ADMIN_SECRET="change-me"

# WT-5 auth: HMAC signing secrets for magic-link + session tokens.
# Set long random strings in production; dev falls back to built-ins.
# AUTH_SECRET="change-me"
# AUTH_MAGIC_SECRET="change-me"

# WT-6 transactional email (Resend). When set, magic links + deadline
# notifications are sent for real; without a key, dev returns the magic link
# in the API response and email sending logs instead of delivering.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Watchtower <hello@watchtower.salmaan.dev>"

# WT-6: absolute base URL used in email links (magic link, unwatch, watchlist).
# Must be the public origin in production; defaults to http://localhost:3000.
# APP_ORIGIN="https://watchtower.salmaan.dev"

# WT-6: sweep cadence (ms, default 3600000 = 1h). NOTIFY_SWEEP_FORCE=1 enables
# the in-process scheduler without a Resend key (dev testing).
# NOTIFY_SWEEP_INTERVAL_MS="3600000"
# NOTIFY_SWEEP_FORCE="1"

# Dev/e2e only: store composed emails in memory (stub sender) instead of
# sending. Never set this in production.
# NOTIFY_STUB_SENDER="1"

# WT-8: field-level encryption at rest (AES-256-GCM + HMAC lookup hashes).
# Set a random 32-byte hex string (64 hex chars) in production; dev falls back
# to a built-in. Changing it invalidates previously encrypted rows.
# FIELD_ENCRYPTION_KEY="<64 hex chars>"

# WT-8: retention sweeps. RETENTION_ENABLED=1 starts the daily in-process
# scheduler; QUEUE_REVIEW_WINDOW_DAYS controls how long unreviewed queued
# uploads are kept before deletion.
# RETENTION_ENABLED="0"
# RETENTION_DAYS="90"
# QUEUE_REVIEW_WINDOW_DAYS="30"

# WT-3: LLM structured extraction (OPTIONAL). When LLM_API_KEY is set, the
# pipeline enriches canonical obligations with ISO dates, per-field confidence,
# and precise amounts via an OpenAI-compatible chat-completions endpoint
# (OpenAI, DeepSeek, Groq, Ollama, …). Deterministic risk logic still gates
# what the user sees; the LLM only improves the durable structured state.
# Without a key, the deterministic engine handles everything.
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"
# LLM_TIMEOUT_MS="30000"

# WT-3: image OCR cache directory (tesseract.js traineddata). Optional; the
# worker uses its own default when unset.
# TESSERACT_CACHE_PATH="./.tessdata"

# WT-11: inbound email (forwarding). RESEND_WEBHOOK_SECRET is the Svix signing
# secret for the `email.received` + reputation webhooks (from the Resend
# webhook details page). Without it the webhook endpoints reject everything.
# REPUTATION_ALERT_EMAIL is who gets paged when the forwarding domain's
# bounce/complaint rate degrades (requires RESEND_API_KEY to send).
# RESEND_WEBHOOK_SECRET="whsec_..."
# REPUTATION_ALERT_EMAIL="ops@example.com"
# REPUTATION_SWEEP_INTERVAL_MS="86400000"
# REPUTATION_SWEEP_FORCE="1"
