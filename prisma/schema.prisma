// Watchtower Phase 1 canonical schema (WT-4)
// Source of truth: prisma/schema.prisma (canonical); conceptual model in
// docs/PHASE0_1_PLAN.md §5.3. Every extracted fact is a row with provenance +
// confidence; every obligation is watchable. Legacy Phase 0 shapes
// (Submission.result JSON) remain for the queue.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Phase 0 legacy: submission queue + waitlist ─────────────────────────────

model Submission {
  id          String   @id @default(cuid())
  variant     String   @default("A") // A/B/C/D positioning variant
  kind        String   @default("paste") // paste | file | queued
  contentType String? // e.g. text/plain, application/pdf, image/png
  content     String // the pasted text or extracted text preview
  filename    String? // original upload filename (file kind only)
  sizeBytes   Int? // upload size, for quotas/observability (file kind only)
  contentHash String? // sha256 of pasted text / decoded upload — dedupe + retention
  rawBytes    String? // base64 raw bytes (queued binary uploads only; Phase 0 manual review, WT-9)
  dataUrl     String? // data: URL for the admin attachment viewer (queued uploads only)
  category    String? // manual document category (WT-9 review loop, e.g. subscription|bill|contract|other)
  status      String   @default("received") // received | analyzing | done | error | queued | reviewed
  analysis    String? // semi-manual analysis note (Phase 0)
  result      String? // JSON-encoded AnalysisResult (Phase 1, deprecated in favor of canonical rows)
  consent     Boolean  @default(false) // WT-8: user accepted the processing notice (consent flow)
  consentAt   DateTime? // WT-8: when consent was given
  createdAt   DateTime @default(now())

  @@index([contentHash, createdAt]) // dedupe lookups + retention sweeps
  @@index([consent, createdAt]) // WT-8: retention/consent sweeps
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing") // landing | admin
  createdAt DateTime @default(now())
}

// ─── Canonical obligation/event schema (WT-4) ────────────────────────────────

model User {
  id             String       @id @default(cuid())
  email          String?      // encrypted at rest (WT-8, AES-256-GCM)
  emailHash      String?      @unique // WT-8: deterministic HMAC for email lookups (encrypted email can't be searched)
  anonymous      Boolean      @default(true) // true until account creation (WT-5)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  documents      Document[]
  obligations    Obligation[]
  watchItems     WatchItem[]
  payments       Payment[]
  events         Event[]
  inboundAddresses InboundAddress[]
  inboundMessages  InboundMessage[]
  ledgerEntries    LedgerEntry[]
}

model Company {
  id          String      @id @default(cuid())
  name        String // canonical/clean name
  normalized  String      @unique // lowercase-keyed dedupe token (Adobe vs Adobe Inc)
  domain      String? // counterparty web domain, when known
  createdAt   DateTime    @default(now())
  obligations Obligation[]
  payments    Payment[]
}

model Document {
  id              String           @id @default(cuid())
  userId          String? // null for fully anonymous submissions (pre-account)
  source          String           @default("paste") // paste | upload | forward
  filename        String?
  contentType     String? // e.g. text/plain, application/pdf, image/png
  extractedText   String // deterministic extraction (text preview for images/PDFs)
  extractionMethod String          @default("raw") // raw | pdf-parse | ocr | llm
  contentHash     String? // sha256 — dedupe + retention sweeps
  storageKey      String? // s3://… once object storage lands (WT-8)
  createdAt       DateTime         @default(now())
  submissionId    String? // link back to the Phase 0 queue row
  user            User?            @relation(fields: [userId], references: [id])
  obligations     Obligation[]
  facts           ProvenanceFact[]
  inboundMessages InboundMessage[]
}

// The core watchable entity: a durable obligation between the user and a
// counterparty (subscription, contract, bill, refund, warranty, renewal, …).
model Obligation {
  id                 String   @id @default(cuid())
  documentId         String?
  userId             String?
  kind               String // subscription | contract | bill | refund | warranty | insurance | renewal | trial | other
  counterpartyId     String?
  counterpartyName   String? // denormalized display name (may exist without a Company row)
  amountCents        Int? // always integer cents — never floats
  currency           String   @default("USD")
  interval           String? // monthly | yearly | one_time | …
  amountConfidence   Float? // ∈ [0,1]
  startDate          DateTime?
  renewalDate        DateTime?
  noticeDeadlineDate DateTime?
  expiryDate         DateTime?
  cancellationNoticeDays Int? // notice period required to cancel
  autoRenews         Boolean? // false = no auto-renewal; null = unknown
  termsQuote         String? // verbatim cancellation/auto-renewal clause
  riskType           String? // price_increase | auto_renewal | forgotten_trial | refund_due | deadline | incorrect_charge | none
  exposureLowCents   Int? // conservative low bound of potential loss
  exposureHighCents  Int? // conservative high bound
  exposureAssumption String? // explicit statement, e.g. "$9.99/mo × 12 = $120 if not cancelled"
  dueDate            DateTime? // when action is required (deadline of the risk)
  verification       String   @default("hypothetical") // certain | conditional | hypothetical
  confidence         Float   @default(0.0) // overall finding confidence ∈ [0,1]
  status             String   @default("open") // open | watched | ignored | resolved | disputed
  userNote           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  document     Document?         @relation(fields: [documentId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  counterparty Company?          @relation(fields: [counterpartyId], references: [id])
  facts        ProvenanceFact[]
  watchItems   WatchItem[]
  deadlines    Deadline[]
  payments     Payment[]
  events       Event[]
  ledgerEntries LedgerEntry[]

  @@index([userId, status])
  @@index([dueDate])
  @@index([renewalDate])
}

// Provenance: every extracted fact is a row with the source quote + offset.
// This is the audit trail that makes confidence explainable and corrections possible.
model ProvenanceFact {
  id          String    @id @default(cuid())
  documentId  String?
  obligationId String?
  label       String // amount | renewal_date | counterparty | deadline | cancellation_terms | …
  value       String // normalized value
  quote       String // verbatim source text
  offsetStart Int? // character offset into extractedText
  offsetEnd   Int?
  confidence  Float? // per-fact confidence ∈ [0,1]
  createdAt   DateTime  @default(now())

  document   Document?   @relation(fields: [documentId], references: [id])
  obligation Obligation? @relation(fields: [obligationId], references: [id])

  @@index([documentId])
  @@index([obligationId])
}

// A user-facing watch item — the persisted state that makes the product recurring.
model WatchItem {
  id          String    @id @default(cuid())
  userId      String?
  obligationId String
  status      String    @default("open") // open | upcoming | due | resolved | dismissed
  deadline    DateTime?
  nextCheckAt DateTime?
  notifiedAt  DateTime? // last notification sent
  userNote    String? // user correction/note (WT-5)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  obligation Obligation  @relation(fields: [obligationId], references: [id])

  @@unique([userId, obligationId]) // one watch item per user per obligation (WT-5)
  @@index([userId, status])
  @@index([obligationId])
}

// Deadlines attached to an obligation (a contract may have several).
model Deadline {
  id          String    @id @default(cuid())
  obligationId String
  kind        String    @default("deadline") // notice | renewal | expiry | payment | other
  dueAt       DateTime
  description String?
  createdAt   DateTime  @default(now())

  obligation Obligation @relation(fields: [obligationId], references: [id])

  @@index([obligationId, dueAt])
}

// Payments / charges mentioned in documents (amounts, intervals).
model Payment {
  id           String    @id @default(cuid())
  userId       String?
  companyId    String?
  obligationId String?
  amountCents  Int
  currency     String    @default("USD")
  interval     String? // monthly | yearly | one_time | …
  date         DateTime?
  description  String?
  createdAt    DateTime  @default(now())

  user       User?       @relation(fields: [userId], references: [id])
  company    Company?    @relation(fields: [companyId], references: [id])
  obligation Obligation? @relation(fields: [obligationId], references: [id])

  @@index([obligationId])
}

// WT-13: the money-protected ledger — the north-star value metric ("money
// protected so far", PRODUCT_BRIEF). Strict categories so claims stay
// defensible (PHASE0_1_PLAN §8, §10):
//   prevented  — projected cost avoided by acting before a charge/deadline
//                (e.g. cancelled before an auto-renewal). Counterfactual:
//                labeled a projection in the UI, never "recovered".
//   recovered  — realized money back (refund, credit, corrected charge).
//   avoided    — a price increase / incorrect charge stopped (realized on the
//                bill, distinct from prevented's hypothetical charge).
// Every entry links to its obligation (and thus its document + provenance),
// so every claimed dollar is traceable to a verified event. Idempotent
// creation: one entry per (obligationId, category) via the unique index.
model LedgerEntry {
  id             String    @id @default(cuid())
  userId         String
  obligationId   String
  category       String // prevented | recovered | avoided
  amountCents    Int // always integer cents — never floats
  currency       String    @default("USD")
  note           String? // free-form context from the user or the pipeline
  source         String    @default("manual") // manual | ingest | admin
  verification   String    @default("verified") // verified | pending
  recordedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id])
  obligation Obligation @relation(fields: [obligationId], references: [id])

  @@unique([userId, obligationId, category]) // WT-13: idempotence per category
  @@index([userId, recordedAt])
  @@index([obligationId])
}

// Event log: what happened to an obligation over time (detected → watched → resolved).
// Append-only; the substrate for outcome verification (Phase 8) + audit.
model Event {
  id          String    @id @default(cuid())
  userId      String?
  obligationId String?
  type        String // created | analyzed | watched | ignored | resolved | disputed | notified | …
  detail      String?
  createdAt   DateTime  @default(now())

  user       User?       @relation(fields: [userId], references: [id])
  obligation Obligation? @relation(fields: [obligationId], references: [id])

  @@index([userId, createdAt])
  @@index([obligationId])
}

// ─── Phase 2: inbound email infrastructure (WT-11) ──────────────────────────

// A per-user unique forwarding address (u-<token>@in.watchtower.salmaan.dev).
// Token is random/unguessable; the address is the auth boundary for inbound.
model InboundAddress {
  id        String    @id @default(cuid())
  userId    String
  localPart String    @unique // "u-<token>" — the unique per-user address
  domain    String // "in.watchtower.salmaan.dev"
  token     String    @unique // the unguessable token (also in localPart)
  active    Boolean   @default(true)
  disabledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  messages InboundMessage[]

  @@index([userId, active])
}

// A received inbound email (WT-11). Row is created as soon as we acknowledge
// the webhook, then filled in as the pipeline runs. Raw text is encrypted at
// rest (WT-8); status drives quarantine/retry/ingest.
model InboundMessage {
  id              String    @id @default(cuid())
  addressId       String? // null for messages not addressed to a known user
  userId          String?
  resendEmailId   String    @unique // Resend email_id (dedupe)
  messageId       String? // RFC Message-ID
  fromEmail       String? // sender (encrypted at rest)
  fromName        String?
  subject         String? // encrypted at rest
  toAddress       String? // recipient address it was delivered to
  receivedFor     String? // address the message was forwarded for
  text            String? // encrypted at rest (plain-text body)
  html            String? // encrypted at rest
  headers         String? // encrypted at rest (JSON)
  rawDownloadUrl  String? // Resend signed URL for the raw email (temporary)
  contentSize     Int? // combined body+attachment bytes
  status          String    @default("received") // received | fetched | quarantined | ingested | failed
  quarantineReason String? // spam | rate_limited | unknown_address | too_large | no_content
  spamScore       Float?
  createdAt       DateTime  @default(now())
  ingestedAt      DateTime?
  documentId      String? // the Document created when ingested
  failure         String? // last error detail

  address  InboundAddress? @relation(fields: [addressId], references: [id])
  user     User?           @relation(fields: [userId], references: [id])
  document Document?       @relation(fields: [documentId], references: [id])

  @@index([addressId, createdAt])
  @@index([status, createdAt])
}

// WT-11: reputation events (bounces/complaints) observed from Resend webhooks
// or the API, so the forwarding domain's health can be monitored. Append-only.
model ReputationEvent {
  id        String    @id @default(cuid())
  kind      String // bounce | complaint | delivered | failed | suppressed
  email     String? // encrypted at rest (the affected recipient address)
  detail    String? // provider detail (bounce type, etc.), never PII
  createdAt DateTime  @default(now())

  @@index([kind, createdAt])
}

// WT-8: append-only audit trail for sensitive operations (admin auth/review,
// auth success/failure, one-click unwatch, retention sweeps). Never exposed
// to the app UI; only readable by the admin surface.
model AuditLog {
  id        String   @id @default(cuid())
  actor     String   @default("system") // admin | user:<id> | system | email:<hash>
  action    String // admin_authorized | admin_denied | admin_review | auth_request | auth_verify_success | auth_verify_failed | unwatch | retention_sweep | consent
  target    String? // entity id or key
  detail    String? // free-form context (never contains plaintext PII)
  ip        String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
}
